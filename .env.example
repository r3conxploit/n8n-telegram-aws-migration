# =============================================================================
# .env.example — salin ke .env.deploy (JANGAN commit .env.deploy)
#   cp .env.example .env.deploy && chmod 600 .env.deploy
#   set -a; . ./.env.deploy; set +a
# =============================================================================

# --- target AWS EC2 -----------------------------------------------------------
# hostname publik atau Elastic IP instance
HOST=ec2-0-0-0-0.ap-southeast-2.compute.amazonaws.com
# user SSH sesuai AMI: Ubuntu=ubuntu, Amazon Linux=ec2-user, Debian=admin
SSH_USER=ubuntu
# private key yang dipasangkan ke instance (chmod 600)
KEY=/c/Users/<user>/.ssh/server-bot.pem

# --- ingress ------------------------------------------------------------------
# domain publik n8n, TANPA https://
DOMAIN=n8n.example.com
# UUID tunnel Cloudflare: cloudflared tunnel list
TUNNEL_ID=00000000-0000-0000-0000-000000000000

# --- runtime (opsional) -------------------------------------------------------
# versi image n8n yang di-pin (jangan pakai 'latest')
N8N_VERSION=2.38.7
# batas heap Node dalam MB (t3.micro 1 GiB -> 768 aman)
HEAP_MB=768
# retensi riwayat eksekusi (hari)
EXECUTIONS_DATA_MAX_AGE=336

# --- lokal (jangan diisi di server) -------------------------------------------
# path state n8n lokal yang dimigrasi
# N8N_LOCAL_DIR=/c/Users/<user>/.n8n
# path credential tunnel lokal
# CLOUDFLARED_DIR=/c/Users/<user>/.cloudflared

# --- secret: JANGAN diisi di file ini -----------------------------------------
# Token bot Telegram, password, dsb. disimpan di credential n8n / secret manager.
# Repo ini tidak pernah menerima nilai rahasia. Lihat docs/security.md.
